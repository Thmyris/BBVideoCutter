# Python
__pycache__/
*.pyc

# PyInstaller/Inno Setup byproducts, scoped to inside release/build/ so
# this doesn't accidentally match release/build/ itself (that folder
# holds the real, tracked build scripts)
release/build/build/
release/build/dist/
release/build/*.spec
release/build/installer_output/

# Built distributables -- regenerate via release/build/*.bat, or publish
# as GitHub Releases instead of tracking in git
release/BBVideoCutter-Setup.exe
release/BBVideoCutter-Portable.zip

# ffmpeg/ffprobe binaries used only for bundling into the build, not part
# of the source itself
release/build/ffmpeg.exe
release/build/ffprobe.exe
# libmpv (embedded video player), also only bundled into the build
release/build/libmpv-2.dll
# DeepFilterNet (the Audio tab's Medium / Extreme noise reduction), likewise
release/build/deep-filter.exe

# Local tooling config
.claude/

# Not tracked per request
TODO.md
